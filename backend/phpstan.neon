includes:
    - vendor/larastan/larastan/extension.neon
   

parameters:
    paths:
        - app
    level: 5
    treatPhpDocTypesAsCertain: false 
    ignoreErrors:
        - path: app/Providers/TelescopeServiceProvider.php
          messages:
              - '#If condition is always true#'
              - '#Unreachable statement#'
