# -----------------------------------------------
# Application
# -----------------------------------------------
APP_NAME=ShiftFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
TELESCOPE_ENABLED=false
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------
# Database (MySQL — required)
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shiftflow
DB_USERNAME=shiftflow_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# -----------------------------------------------
# Cache & Queue
# Fallback (no Redis): CACHE_STORE=file, QUEUE_CONNECTION=database
# With Redis:          CACHE_STORE=redis, QUEUE_CONNECTION=redis
# -----------------------------------------------
CACHE_STORE=file
QUEUE_CONNECTION=database

# Redis (optional — required for JWT blacklist and faster cache)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# Authentication
# -----------------------------------------------
AUTH_GUARD=api
AUTH_PASSWORD_BROKER=users

# Generate with: php artisan jwt:secret
JWT_SECRET=

# Default PIN assigned to new employee accounts (employee changes on first login)
DEFAULT_EMPLOYEE_PIN=1234

# -----------------------------------------------
# Security
# -----------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------
# Filesystem
# -----------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------
# Mail (not used in current version)
# -----------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
