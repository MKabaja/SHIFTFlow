# -----------------------------------------------
# Application
# -----------------------------------------------
APP_NAME=ShiftFlow
APP_ENV=local
APP_KEY=base64:UI0x2UEIO1TNXSnJ1nVwlB2bOl+0Nm2rjWlZOWxQeDE=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------
# Database (MySQL — Docker service name: db)
# -----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=shiftflow_db
DB_USERNAME=shiftflow_user
DB_PASSWORD=shiftflow_pass

# -----------------------------------------------
# Cache & Queue
# -----------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database

# Redis 
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------
# Authentication
# -----------------------------------------------
AUTH_GUARD=api
AUTH_PASSWORD_BROKER=users

# Generate with: php artisan jwt:secret
JWT_SECRET=LswJusfzf7HhW9DNpbzPTEqmhe6Sg2LzcoYGH1E8rlyUqkw9w5kOlf8FM8pStDDj

# Default PIN assigned to new employee accounts (employee changes on first login)
DEFAULT_EMPLOYEE_PIN=1234

# -----------------------------------------------
# Security
# -----------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------
# Filesystem
# -----------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------
# Mail (not used in current version)
# -----------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
